{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024"]
  },
  "include": ["src/**/*.js", "dev/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules", "web"]
}
